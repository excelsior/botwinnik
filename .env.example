# Settings for docker compose (see "Running on a server" in README.md). Copy
# this file to .env, which is git-ignored. The API keys go in config.ini.

# The domain name pointing at the server, which its HTTPS certificate is for,
# or, without one, the server's public IP address.
DOMAIN=chess.example.com

# The login the page asks for. The password goes in as a hash: run
#   docker run --rm -it caddy:2 caddy hash-password
# type the password, and paste what it prints between the single quotes, which
# keep its $ signs from being read as variables.
LOGIN_USER=admin
LOGIN_PASSWORD_HASH=''
